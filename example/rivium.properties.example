# Copy this file to rivium.properties (same folder) and fill it in. rivium.properties is ignored by git.
#
# Your project's PUBLIC key (Console > your project > API keys). Starts with rv_live_.
# Never put the server secret (rv_srv_...) in an app.
RIVIUM_API_KEY=rv_live_xxxxxxxxxxxx

# Your token server (the Node.js example's server, or your own). It holds the server secret and answers:
#   POST /token  {"userId":"...","expiresIn":3600}  -> {"token":"...","expiresAt":"..."}
#   POST /signed-url    {"fileId":"...","expiresIn":600}   -> {"url":"..."}
# On a phone use your computer's LAN address, e.g. http://192.168.1.20:4000 (not localhost).
# From the Android emulator, http://10.0.2.2:4000 is your computer.
TOKEN_SERVER_URL=http://10.0.2.2:4000

# Test buckets (Node example: npm run setup-buckets, or the Console; see README.md).
PUBLIC_BUCKET=rivium-example-public
PRIVATE_BUCKET=rivium-example-private-images

# The user id your token server signs in (the app asks for a token for this id).
DEMO_USER_ID=demo-user
